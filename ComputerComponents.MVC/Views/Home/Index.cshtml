@model IEnumerable<ComputerComponents.Domain.Entities.Component>
@{
    ViewData["Title"] = "لوحة التحكم الرئيسية";
}

<!-- Top Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="custom-card d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted d-block small fw-bold mb-1">إجمالي الفئات</span>
                <h3 class="fw-extrabold m-0 text-info">@ViewBag.CategoriesCount</h3>
            </div>
            <div class="bg-info bg-opacity-10 p-3 rounded-4 text-info">
                <i class="fa-solid fa-layer-group fa-2x"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="custom-card d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted d-block small fw-bold mb-1">إجمالي المكونات</span>
                <h3 class="fw-extrabold m-0 text-primary">@ViewBag.ComponentsCount</h3>
            </div>
            <div class="bg-primary bg-opacity-10 p-3 rounded-4 text-primary">
                <i class="fa-solid fa-desktop fa-2x"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="custom-card d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted d-block small fw-bold mb-1">المواصفات الفنية</span>
                <h3 class="fw-extrabold m-0 text-warning">@ViewBag.SpecificationsCount</h3>
            </div>
            <div class="bg-warning bg-opacity-10 p-3 rounded-4 text-warning">
                <i class="fa-solid fa-sliders fa-2x"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="custom-card d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted d-block small fw-bold mb-1">عدد المستخدمين</span>
                <h3 class="fw-extrabold m-0 text-success">@ViewBag.UsersCount</h3>
            </div>
            <div class="bg-success bg-opacity-10 p-3 rounded-4 text-success">
                <i class="fa-solid fa-users fa-2x"></i>
            </div>
        </div>
    </div>
</div>

<!-- Dashboard Grid & Chart -->
<div class="row g-4">
    <!-- Left Column: Chart -->
    <div class="col-lg-5">
        <div class="custom-card h-100">
            <h6 class="fw-bold mb-3 text-white"><i class="fa-solid fa-chart-donut text-cyan me-2"></i> توزيع المكونات حسب الفئات</h6>
            <div class="position-relative d-flex justify-content-center align-items-center" style="height: 280px;">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Right Column: Recent Added Components -->
    <div class="col-lg-7">
        <div class="custom-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold m-0 text-white"><i class="fa-solid fa-clock-rotate-left text-cyan me-2"></i> أحدث المكونات المُضافة</h6>
                <a href="/Components/Index" class="btn btn-sm btn-cyan">عرض الكل</a>
            </div>
            <div class="table-responsive">
                <table class="table table-custom align-middle m-0">
                    <thead>
                        <tr>
                            <th>المكوّن</th>
                            <th>الفئة</th>
                            <th>الموديل</th>
                            <th>السعر</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var comp in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="@comp.ImageUrl" width="36" height="36" class="rounded-3 object-fit-cover" alt="@comp.ComponentName" />
                                            <span class="fw-bold">@comp.ComponentName</span>
                                        </div>
                                    </td>
                                    <td><span class="badge bg-secondary bg-opacity-50">@(comp.Category?.CategoryName ?? "عام")</span></td>
                                    <td><code class="text-info">@comp.Model</code></td>
                                    <td class="text-success fw-bold">$@comp.Price</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center text-muted">لا توجد بيانات حالياً</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const ctx = document.getElementById('categoryChart').getContext('2d');
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['معالجات (CPUs)', 'كروت شاشة (GPUs)', 'ذاكرة عشوائية (RAM)', 'أجهزة تخزين (SSD)'],
                    datasets: [{
                        data: [5, 3, 4, 2],
                        backgroundColor: ['#38bdf8', '#818cf8', '#f59e0b', '#10b981'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { color: '#94a3b8', font: { family: 'Cairo' } }
                        }
                    }
                }
            });
        });
    </script>
}
