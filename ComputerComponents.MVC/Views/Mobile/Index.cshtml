@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تطبيق الفلاتر للموبايل - Flutter Mobile App Interface</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background: radial-gradient(circle at center, #1e293b 0%, #0b0f19 100%);
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            margin: 0;
        }

        /* Mobile Device Frame */
        .mobile-frame {
            width: 410px;
            height: 840px;
            background-color: #0b0f19;
            border-radius: 44px;
            border: 12px solid #1e293b;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8), 0 0 40px rgba(14, 165, 233, 0.35);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
        }

        .mobile-notch {
            width: 150px;
            height: 24px;
            background-color: #1e293b;
            position: absolute;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            border-bottom-left-radius: 16px;
            border-bottom-right-radius: 16px;
            z-index: 1000;
        }

        .mobile-header {
            background-color: #1e293b;
            padding: 34px 16px 14px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.15);
        }

        .mobile-body {
            flex: 1;
            overflow-y: auto;
            padding: 16px;
        }

        .mobile-nav {
            background-color: #1e293b;
            display: flex;
            justify-content: space-around;
            padding: 10px 0;
            border-top: 1px solid rgba(255, 255, 255, 0.15);
        }

        .nav-item-btn {
            background: none;
            border: none;
            color: #94a3b8;
            display: flex;
            flex-direction: column;
            align-items: center;
            font-size: 11px;
            font-weight: 700;
            gap: 4px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .nav-item-btn.active {
            color: #38bdf8;
        }

        .nav-item-btn i {
            font-size: 20px;
        }

        .card-custom {
            background-color: #1e293b;
            border-radius: 16px;
            padding: 14px;
            margin-bottom: 12px;
            border: 1px solid rgba(255, 255, 255, 0.12);
        }

        .btn-cyan {
            background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
            color: #ffffff;
            border: none;
            font-weight: 800;
            border-radius: 12px;
            padding: 8px 16px;
        }

        .btn-cyan:hover {
            background: linear-gradient(135deg, #38bdf8 0%, #0ea5e9 100%);
            color: #ffffff;
        }

        .form-control, .form-select {
            background-color: #ffffff !important;
            color: #000000 !important;
            font-weight: 700;
            border-radius: 10px;
            padding: 10px 14px;
        }
    </style>
</head>
<body>

<div class="mobile-frame">
    <div class="mobile-notch"></div>

    <!-- Header -->
    <div class="mobile-header">
        <div class="d-flex align-items-center gap-2">
            <i class="fa-solid fa-microchip text-info fs-5"></i>
            <span class="fw-bold fs-6" id="appTitle">دليل المكونات - Flutter</span>
        </div>
        <div>
            <span class="badge bg-success bg-opacity-25 text-success border border-success d-inline-flex align-items-center gap-1">
                <span class="spinner-grow spinner-grow-sm text-success" style="width: 6px; height: 6px;"></span>
                Live Sync
            </span>
        </div>
    </div>

    <!-- Body Container -->
    <div class="mobile-body" id="mobileContent">
        <!-- Content dynamically rendered via JS -->
    </div>

    <!-- Bottom Navigation Bar -->
    <div class="mobile-nav">
        <button class="nav-item-btn active" onclick="switchTab('dashboard', this)">
            <i class="fa-solid fa-chart-pie"></i>
            <span>الرئيسية</span>
        </button>
        <button class="nav-item-btn" onclick="switchTab('components', this)">
            <i class="fa-solid fa-desktop"></i>
            <span>المكونات</span>
        </button>
        <button class="nav-item-btn" onclick="switchTab('categories', this)">
            <i class="fa-solid fa-layer-group"></i>
            <span>التصنيفات</span>
        </button>
        <button class="nav-item-btn" onclick="switchTab('users', this)">
            <i class="fa-solid fa-users"></i>
            <span>المستخدمون</span>
        </button>
    </div>
</div>

<script>
    const API_BASE = '/api';

    async function switchTab(tab, btn) {
        document.querySelectorAll('.nav-item-btn').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');

        const content = document.getElementById('mobileContent');

        if (tab === 'dashboard') {
            document.getElementById('appTitle').innerText = "لوحة التحكم - Flutter";
            content.innerHTML = `<div class="text-center py-5"><div class="spinner-border text-info"></div></div>`;
            
            try {
                const res = await fetch(`${API_BASE}/dashboard/stats`);
                const data = await res.json();
                
                content.innerHTML = `
                    <div class="card-custom bg-primary bg-gradient text-white mb-3 shadow">
                        <h6 class="fw-bold m-0">نظام المكونات الذكي 🚀</h6>
                        <small class="text-white-50">تزامن فوري ومباشر مع الويب وقاعدة البيانات</small>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <div class="card-custom text-center py-3">
                                <i class="fa-solid fa-desktop text-info fs-3 mb-1"></i>
                                <h5 class="fw-bold m-0 text-white">${data.totalComponents}</h5>
                                <small class="text-muted">القطع الإجمالية</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="card-custom text-center py-3">
                                <i class="fa-solid fa-layer-group text-success fs-3 mb-1"></i>
                                <h5 class="fw-bold m-0 text-white">${data.totalCategories}</h5>
                                <small class="text-muted">التصنيفات</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="card-custom text-center py-3">
                                <i class="fa-solid fa-users text-warning fs-3 mb-1"></i>
                                <h5 class="fw-bold m-0 text-white">${data.totalUsers}</h5>
                                <small class="text-muted">المستخدمون</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="card-custom text-center py-3">
                                <i class="fa-solid fa-dollar-sign text-danger fs-3 mb-1"></i>
                                <h5 class="fw-bold m-0 text-white">$${data.totalInventoryValue}</h5>
                                <small class="text-muted">القيمة الكلية</small>
                            </div>
                        </div>
                    </div>
                    <h6 class="fw-bold mb-2 text-white">أحدث المكونات المضافة 🖥️</h6>
                    ${data.recentComponents.map(c => `
                        <div class="card-custom d-flex align-items-center gap-3">
                            <img src="${c.imageUrl || 'https://images.unsplash.com/photo-1587202372775-e229f172b9d7?w=500'}" 
                                 width="45" height="45" class="rounded-3 object-fit-cover border border-secondary" 
                                 onerror="this.src='https://images.unsplash.com/photo-1587202372775-e229f172b9d7?w=400';" />
                            <div class="flex-grow-1">
                                <div class="fw-bold text-white fs-6">${c.componentName}</div>
                                <small class="text-muted">${c.model}</small>
                            </div>
                            <span class="badge bg-success fs-6">$${c.price}</span>
                        </div>
                    `).join('')}
                `;
            } catch (e) {
                content.innerHTML = `<div class="alert alert-danger">تعذر تحميل البيانات من API</div>`;
            }
        } 
        else if (tab === 'components') {
            document.getElementById('appTitle').innerText = "إدارة المكونات - Flutter";
            content.innerHTML = `<div class="text-center py-5"><div class="spinner-border text-info"></div></div>`;
            
            try {
                const res = await fetch(`${API_BASE}/components`);
                const items = await res.json();
                
                content.innerHTML = `
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold m-0 text-white">قائمة المكونات (${items.length})</h6>
                        <button class="btn btn-cyan btn-sm" onclick="showAddMobileComponent()"><i class="fa-solid fa-plus me-1"></i> إضافة</button>
                    </div>
                    <div id="mobileItemsList">
                    ${items.map(c => `
                        <div class="card-custom mb-2">
                            <div class="d-flex align-items-center gap-3">
                                <img src="${c.imageUrl || 'https://images.unsplash.com/photo-1587202372775-e229f172b9d7?w=500'}" 
                                     width="50" height="50" class="rounded-3 object-fit-cover border border-info" 
                                     onerror="this.src='https://images.unsplash.com/photo-1587202372775-e229f172b9d7?w=400';" />
                                <div class="flex-grow-1">
                                    <div class="fw-bold text-white">${c.componentName}</div>
                                    <small class="text-info">${c.model}</small>
                                </div>
                                <div class="text-end">
                                    <div class="text-success fw-bold">$${c.price}</div>
                                    <button class="btn btn-sm btn-link text-danger p-0 mt-1" onclick="deleteMobileComponent(${c.id})"><i class="fa-solid fa-trash"></i></button>
                                </div>
                            </div>
                        </div>
                    `).join('')}
                    </div>
                `;
            } catch (e) {
                content.innerHTML = `<div class="alert alert-danger">خطأ في الاتصال بالـ API</div>`;
            }
        }
        else if (tab === 'categories') {
            document.getElementById('appTitle').innerText = "تصنيفات الأجهزة - Flutter";
            content.innerHTML = `<div class="text-center py-5"><div class="spinner-border text-info"></div></div>`;
            
            try {
                const res = await fetch(`${API_BASE}/categories`);
                const cats = await res.json();
                
                content.innerHTML = `
                    <h6 class="fw-bold mb-3 text-white">فئات ومكونات النظام</h6>
                    <div class="row g-2">
                        ${cats.map(cat => `
                            <div class="col-6">
                                <div class="card-custom text-center">
                                    <i class="fa-solid fa-folder-open text-warning fs-3 mb-2"></i>
                                    <div class="fw-bold text-white text-truncate">${cat.categoryName}</div>
                                    <small class="text-muted d-block text-truncate">${cat.description || 'لا يوجد وصف'}</small>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                `;
            } catch (e) {
                content.innerHTML = `<div class="alert alert-danger">خطأ في الاتصال بالـ API</div>`;
            }
        }
        else if (tab === 'users') {
            document.getElementById('appTitle').innerText = "إدارة المستخدمين - Flutter";
            content.innerHTML = `<div class="text-center py-5"><div class="spinner-border text-info"></div></div>`;
            
            try {
                const res = await fetch(`${API_BASE}/users`);
                const users = await res.json();
                
                content.innerHTML = `
                    <h6 class="fw-bold mb-3 text-white">سجل مستخدمي النظام (${users.length})</h6>
                    ${users.map(u => `
                        <div class="card-custom d-flex align-items-center gap-3">
                            <i class="fa-solid fa-circle-user text-info fs-2"></i>
                            <div class="flex-grow-1">
                                <div class="fw-bold text-white">${u.fullName}</div>
                                <small class="text-muted">${u.email}</small>
                            </div>
                            <span class="badge ${u.role === 'مدير نظام' ? 'bg-primary' : 'bg-secondary'}">${u.role}</span>
                        </div>
                    `).join('')}
                `;
            } catch (e) {
                content.innerHTML = `<div class="alert alert-danger">خطأ في الاتصال بالـ API</div>`;
            }
        }
    }

    async function showAddMobileComponent() {
        const name = prompt("أدخل اسم المكون الجديد:");
        if (!name) return;
        const model = prompt("أدخل رقم الموديل (Model):") || "Standard";
        const price = parseFloat(prompt("أدخل السعر ($):") || "100");

        try {
            await fetch(`${API_BASE}/components`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    componentName: name,
                    model: model,
                    price: price,
                    categoryId: 1,
                    imageUrl: "https://images.unsplash.com/photo-1587202372775-e229f172b9d7?w=500"
                })
            });
            alert("تمت الإضافة بنجاح وتزامنها مع الويب!");
            switchTab('components');
        } catch (e) {
            alert("حدث خطأ أثناء الإضافة");
        }
    }

    async function deleteMobileComponent(id) {
        if (!confirm("هل أنت متأكد من الحذف؟")) return;
        try {
            await fetch(`${API_BASE}/components/${id}`, { method: 'DELETE' });
            switchTab('components');
        } catch (e) {
            alert("خطأ في الحذف");
        }
    }

    // Load initial tab
    switchTab('dashboard');
</script>

</body>
</html>
