<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام إدارة مكونات الحاسوب</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <!-- Bootstrap RTL CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --bg-primary: #0f172a;
            --bg-card: #1e293b;
            --text-main: #ffffff;
            --sidebar-width: 270px;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: #0b0f19;
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* High contrast text overrides */
        .text-muted {
            color: #cbd5e1 !important; /* Bright readable slate grey */
        }

        /* Sidebar Styling */
        .sidebar {
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
            border-left: 1px solid rgba(255, 255, 255, 0.15);
            position: fixed;
            top: 0;
            bottom: 0;
            right: 0;
            z-index: 1000;
            padding-top: 1.5rem;
        }

        .sidebar-brand {
            padding: 0 1.5rem 1.5rem 1.5rem;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.15);
            color: #38bdf8;
            font-weight: 800;
            font-size: 1.3rem;
        }

        .sidebar-menu {
            list-style: none;
            padding: 1rem 0;
            margin: 0;
        }

        .sidebar-menu li a {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 14px 1.5rem;
            color: #e2e8f0;
            text-decoration: none;
            font-weight: 700;
            font-size: 1rem;
            transition: all 0.2s ease;
        }

        .sidebar-menu li a:hover, .sidebar-menu li a.active {
            color: #ffffff;
            background: linear-gradient(90deg, rgba(56, 189, 248, 0.2) 0%, rgba(56, 189, 248, 0.05) 100%);
            border-right: 5px solid #38bdf8;
        }

        .main-content {
            margin-right: var(--sidebar-width);
            padding: 2rem;
            flex: 1;
        }

        /* Navbar top */
        .top-navbar {
            background: #1e293b;
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 16px;
            padding: 1rem 1.5rem;
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        /* Cards */
        .custom-card {
            background: #1e293b;
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 16px;
            padding: 1.5rem;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4);
        }

        /* Tables - High contrast */
        .table-custom {
            color: #000000 !important;
            background-color: #ffffff !important;
            vertical-align: middle;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }
        .table-custom th {
            background-color: #f1f5f9 !important;
            color: #0f172a !important;
            font-weight: 900;
            border-bottom: 2px solid #cbd5e1 !important;
            padding: 1rem;
            font-size: 1.1rem;
        }
        .table-custom td {
            border-bottom: 1px solid #e2e8f0 !important;
            padding: 1rem;
            color: #000000 !important;
            font-weight: 700;
            font-size: 1.05rem;
            background-color: #ffffff !important;
        }

        /* Action Buttons */
        .btn-action-edit {
            background-color: #f59e0b;
            color: #000000 !important;
            font-weight: 800;
            border: none;
            padding: 6px 14px;
            border-radius: 8px;
            font-size: 0.9rem;
            transition: all 0.2s ease;
        }
        .btn-action-edit:hover {
            background-color: #d97706;
            color: #000000 !important;
        }

        .btn-action-delete {
            background-color: #ef4444;
            color: #ffffff !important;
            font-weight: 800;
            border: none;
            padding: 6px 14px;
            border-radius: 8px;
            font-size: 0.9rem;
            transition: all 0.2s ease;
        }
        .btn-action-delete:hover {
            background-color: #dc2626;
            color: #ffffff !important;
        }

        .btn-cyan {
            background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
            color: #ffffff !important;
            border: none;
            font-weight: 800;
            border-radius: 10px;
            padding: 10px 20px;
        }
        .btn-cyan:hover {
            background: linear-gradient(135deg, #38bdf8 0%, #0ea5e9 100%);
            color: #ffffff !important;
        }

        /* Modal styling - High contrast */
        .modal-content {
            background-color: #1e293b;
            color: #ffffff;
            border: 2px solid #38bdf8;
            border-radius: 18px;
        }
        .modal-header {
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
            background-color: #0f172a;
            border-top-left-radius: 16px;
            border-top-right-radius: 16px;
        }
        .modal-footer {
            border-top: 1px solid rgba(255, 255, 255, 0.2);
            background-color: #0f172a;
            border-bottom-left-radius: 16px;
            border-bottom-right-radius: 16px;
        }
        .form-control, .form-select, select, select option, select optgroup {
            background-color: #ffffff !important;
            border: 2px solid #cbd5e1 !important;
            color: #000000 !important;
            border-radius: 10px;
            font-weight: 800 !important;
            font-size: 1.1rem !important;
            padding: 12px 16px;
        }
        .form-select option {
            background-color: #ffffff !important;
            color: #000000 !important;
            font-weight: 800 !important;
            padding: 10px;
        }
        .form-control::placeholder, .form-select::placeholder {
            color: #475569 !important;
            opacity: 1;
            font-weight: 700;
        }
        .form-control:focus, .form-select:focus, select:focus {
            background-color: #ffffff !important;
            border-color: #0ea5e9 !important;
            color: #000000 !important;
            box-shadow: 0 0 0 0.25rem rgba(14, 165, 233, 0.25);
        }
        .form-label {
            color: #f8fafc !important;
            font-weight: 800 !important;
            font-size: 1.05rem;
            margin-bottom: 8px;
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-brand">
            <i class="fa-solid fa-microchip fa-lg"></i>
            <span>نظام المكونات</span>
        </div>
        <ul class="sidebar-menu">
            <li>
                <a href="/Home/Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                    <i class="fa-solid fa-chart-pie"></i> لوحة التحكم
                </a>
            </li>
            <li>
                <a href="/Categories/Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")">
                    <i class="fa-solid fa-layer-group"></i> إدارة الفئات
                </a>
            </li>
            <li>
                <a href="/Components/Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Components" ? "active" : "")">
                    <i class="fa-solid fa-desktop"></i> إدارة المكونات
                </a>
            </li>
            <li>
                <a href="/Specifications/Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Specifications" ? "active" : "")">
                    <i class="fa-solid fa-sliders"></i> المواصفات الفنية
                </a>
            </li>
            <li>
                <a href="/Users/Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")">
                    <i class="fa-solid fa-users-gear"></i> إدارة المستخدمين
                </a>
            </li>
            <li class="mt-3 pt-3 border-top border-secondary">
                <a href="/Mobile/Index" target="_blank" class="text-cyan fw-extrabold">
                    <i class="fa-solid fa-mobile-screen-button text-info"></i> 📱 واجهة تطبيق الفلاتر (Flutter)
                </a>
            </li>
        </ul>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <div class="top-navbar">
            <div class="d-flex align-items-center gap-3">
                <h4 class="m-0 font-weight-bold text-white"><i class="fa-solid fa-hashtag text-info me-2"></i> @ViewData["Title"]</h4>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="text-start">
                    <span class="d-block text-white fw-bold fs-6">المدير العام</span>
                    <small class="text-muted">admin@system.com</small>
                </div>
                <a href="/Account/Logout" class="btn btn-outline-danger btn-sm rounded-circle p-2" title="تسجيل الخروج">
                    <i class="fa-solid fa-power-off"></i>
                </a>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 bg-success bg-opacity-25 text-white mb-4 fw-bold fs-6" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
