@model IEnumerable<ComputerComponents.Domain.Entities.Specification>
@{
    ViewData["Title"] = "إدارة المواصفات الفنية للقطع";
}

<div class="custom-card mb-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-extrabold text-white mb-1"><i class="fa-solid fa-sliders text-warning me-2"></i> دليل المواصفات والتفاصيل الفنية</h4>
            <p class="text-muted small m-0 fw-bold">إدارة خواص ومواصفات المكونات (مثل التردد، الذاكرة، الطاقة...)</p>
        </div>
        <button class="btn btn-cyan" data-bs-toggle="modal" data-bs-target="#addSpecModal">
            <i class="fa-solid fa-plus me-1"></i> إضافة خاصية جديدة
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-custom align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>المكوّن التابع له</th>
                    <th>اسم الخاصية</th>
                    <th>قيمة الخاصية</th>
                    <th style="width: 220px;" class="text-center">إجراءات التحكم</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int idx = 1;
                    foreach (var s in Model)
                    {
                        <tr>
                            <td class="fw-bold fs-6">@idx</td>
                            <td class="fw-bold fs-6">@(s.Component?.ComponentName ?? "عام")</td>
                            <td><span class="badge bg-dark border border-info text-info fs-6 px-3 py-2">@s.PropertyName</span></td>
                            <td><span class="text-success fw-extrabold fs-6">@s.PropertyValue</span></td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <!-- Edit Button -->
                                    <button type="button" class="btn btn-action-edit" title="تعديل الخاصية"
                                            onclick="openEditSpecModal(@s.Id, @s.ComponentId, '@s.PropertyName', '@s.PropertyValue')">
                                        <i class="fa-solid fa-pen-to-square me-1"></i> تعديل
                                    </button>
                                    <!-- Delete Button Form -->
                                    <form action="/Specifications/Delete" method="post" class="d-inline" onsubmit="return confirm('هل أنت تأكد من حذف الخاصية (@s.PropertyName)؟');">
                                        <input type="hidden" name="id" value="@s.Id" />
                                        <button type="submit" class="btn btn-action-delete" title="حذف الخاصية">
                                            <i class="fa-solid fa-trash me-1"></i> حذف
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        idx++;
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center text-white py-4 fs-5">لا توجد مواصفات فنية مضافة حالياً.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Spec Modal -->
<div class="modal fade" id="addSpecModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-white fw-bold"><i class="fa-solid fa-plus text-warning me-2"></i> إضافة خاصية/مواصفة جديدة</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/Specifications/Create" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">المكوّن المستهدف</label>
                        <select name="ComponentId" class="form-select" asp-items="ViewBag.Components" required>
                            <option value="">-- اختر المكوّن --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">اسم الخاصية (PropertyName)</label>
                        <input type="text" name="PropertyName" class="form-control" required placeholder="مثال: التردد / VRAM / التغذية" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">قيمة الخاصية (PropertyValue)</label>
                        <input type="text" name="PropertyValue" class="form-control" required placeholder="مثال: 5.7 GHz / 24GB GDDR6X" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-cyan">حفظ الخاصية</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Spec Modal -->
<div class="modal fade" id="editSpecModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-white fw-bold"><i class="fa-solid fa-pen text-warning me-2"></i> تعديل الخاصية</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/Specifications/Edit" method="post">
                <input type="hidden" id="editSpecId" name="Id" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">المكوّن المستهدف</label>
                        <select id="editSpecCompId" name="ComponentId" class="form-select" asp-items="ViewBag.Components" required>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">اسم الخاصية</label>
                        <input type="text" id="editSpecPropName" name="PropertyName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">قيمة الخاصية</label>
                        <input type="text" id="editSpecPropValue" name="PropertyValue" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-warning text-dark fw-extrabold">تحديث البيانات</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditSpecModal(id, compId, propName, propValue) {
            document.getElementById('editSpecId').value = id;
            document.getElementById('editSpecCompId').value = compId;
            document.getElementById('editSpecPropName').value = propName;
            document.getElementById('editSpecPropValue').value = propValue;
            var modal = new bootstrap.Modal(document.getElementById('editSpecModal'));
            modal.show();
        }
    </script>
}
