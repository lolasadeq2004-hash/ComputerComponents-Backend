@model IEnumerable<ComputerComponents.Domain.Entities.User>
@{
    ViewData["Title"] = "إدارة مستخدمي النظام والأنشطة";
}

<div class="custom-card mb-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-extrabold text-white mb-1"><i class="fa-solid fa-users-gear text-success me-2"></i> سجل مستخدمي النظام والأدوار</h4>
            <p class="text-muted small m-0 fw-bold">إدارة الحسابات المسجلة، الصلاحيات والأدوار الفعالة</p>
        </div>
        <button class="btn btn-cyan" data-bs-toggle="modal" data-bs-target="#addUserModal">
            <i class="fa-solid fa-user-plus me-1"></i> إضافة مستخدم جديد
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-custom align-middle">
            <thead>
                <tr>
                    <th>المستخدم</th>
                    <th>البريد الإلكتروني</th>
                    <th>الدور / Role</th>
                    <th>الحالة</th>
                    <th>تاريخ التسجيل</th>
                    <th style="width: 220px;" class="text-center">إجراءات التحكم</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var u in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-primary bg-opacity-50 text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width:40px; height:40px;">
                                        <i class="fa-solid fa-user"></i>
                                    </div>
                                    <span class="fw-bold fs-6">@u.FullName</span>
                                </div>
                            </td>
                            <td><span class="fs-6">@u.Email</span></td>
                            <td>
                                <span class="badge @(u.Role == "مدير نظام" ? "bg-info text-dark" : "bg-secondary text-white") fs-6 px-3 py-2">
                                    @u.Role
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-success text-white fs-6 px-3 py-2">
                                    <i class="fa-solid fa-circle-check me-1"></i> @u.Status
                                </span>
                            </td>
                            <td><span class="fs-6">@u.CreatedAt.ToString("yyyy-MM-dd")</span></td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <!-- Edit Button -->
                                    <button type="button" class="btn btn-action-edit" title="تعديل المستخدم"
                                            onclick="openEditUserModal(@u.Id, '@u.FullName', '@u.Email', '@u.Role', '@u.Status')">
                                        <i class="fa-solid fa-pen-to-square me-1"></i> تعديل
                                    </button>
                                    <!-- Delete Button Form -->
                                    <form action="/Users/Delete" method="post" class="d-inline" onsubmit="return confirm('هل أنت تأكد من حذف حساب المستخدم (@u.FullName)؟');">
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <button type="submit" class="btn btn-action-delete" title="حذف المستخدم">
                                            <i class="fa-solid fa-trash me-1"></i> حذف
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center text-white py-4 fs-5">لا يوجد مستخدمون حالياً.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add User Modal -->
<div class="modal fade" id="addUserModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-white fw-bold"><i class="fa-solid fa-user-plus text-success me-2"></i> إضافة مستخدم جديد</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/Users/Create" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">الاسم الكامل</label>
                        <input type="text" name="FullName" class="form-control" required placeholder="مثال: خالد محمد" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">البريد الإلكتروني</label>
                        <input type="email" name="Email" class="form-control" required placeholder="khalid@domain.com" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">كلمة المرور</label>
                        <input type="password" name="Password" class="form-control" required placeholder="••••••••" />
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">الدور / Role</label>
                            <select name="Role" class="form-select" required>
                                <option value="مدير نظام">مدير نظام</option>
                                <option value="مستعمل" selected>مستعمل</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">الحالة</label>
                            <select name="Status" class="form-select" required>
                                <option value="نشط" selected>نشط</option>
                                <option value="غير نشط">غير نشط</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-cyan">إضافة المستخدم</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit User Modal -->
<div class="modal fade" id="editUserModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-white fw-bold"><i class="fa-solid fa-pen text-warning me-2"></i> تعديل حساب المستخدم</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/Users/Edit" method="post">
                <input type="hidden" id="editUserId" name="Id" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">الاسم الكامل</label>
                        <input type="text" id="editUserFullName" name="FullName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">البريد الإلكتروني</label>
                        <input type="email" id="editUserEmail" name="Email" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">كلمة مرور جديدة (اختياري)</label>
                        <input type="password" name="Password" class="form-control" placeholder="اتركه فارغاً للحفاظ على كلمة المرور القديمة" />
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">الدور</label>
                            <select id="editUserRole" name="Role" class="form-select">
                                <option value="مدير نظام">مدير نظام</option>
                                <option value="مستعمل">مستعمل</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">الحالة</label>
                            <select id="editUserStatus" name="Status" class="form-select">
                                <option value="نشط">نشط</option>
                                <option value="غير نشط">غير نشط</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-warning text-dark fw-extrabold">حفظ التغييرات</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditUserModal(id, fullName, email, role, status) {
            document.getElementById('editUserId').value = id;
            document.getElementById('editUserFullName').value = fullName;
            document.getElementById('editUserEmail').value = email;
            document.getElementById('editUserRole').value = role;
            document.getElementById('editUserStatus').value = status;
            var modal = new bootstrap.Modal(document.getElementById('editUserModal'));
            modal.show();
        }
    </script>
}
